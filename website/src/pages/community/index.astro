---
import Layout from '../../layouts/Layout.astro';
---

<Layout title="社区 · 幻觉">
  <div class="max-w-3xl mx-auto px-6 py-12 text-center">
    <h1 class="text-3xl font-bold mb-4">读者社区</h1>
    <p class="text-muted mb-10 max-w-md mx-auto">
      社区互动功能正在建设中。近期将开放章节评论、读者讨论区等功能。
    </p>

    <div class="p-8 border border-dashed border-paper-dark rounded-lg inline-block">
      <p class="text-4xl mb-3">🏗️</p>
      <p class="text-muted">Coming Soon</p>
    </div>
  </div>
</Layout>
