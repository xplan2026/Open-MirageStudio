#!/usr/bin/env bash
# ============================================================
# Lemong Agent CLI — AI 音乐创作统一命令行入口
# ============================================================
# 
# 用法（在项目根目录 /workspace/ 下执行）:
#   ./lemong-agent/lemong-agent help              # 查看帮助
#   ./lemong-agent/lemong-agent list-styles       # 列出可用风格
#   ./lemong-agent/lemong-agent list-templates    # 列出模板详情
#   ./lemong-agent/lemong-agent prompt <风格> <答案JSON>  # 生成提示词
#   ./lemong-agent/lemong-agent lyrics --theme "主题"     # 生成歌词
#   ./lemong-agent/lemong-agent generate ...              # 生成音乐
#   ./lemong-agent/lemong-agent status                    # 查看状态

set -euo pipefail

# ============ 路径配置 ============

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"         # lemong-agent/
AGENT_DIR="$SCRIPT_DIR"                              # lemong-agent/
SCRIPTS_DIR="$AGENT_DIR/scripts"
WORKSPACE_ROOT="$(cd "$AGENT_DIR/.." && pwd)"        # /workspace
DATA_DIR="$WORKSPACE_ROOT/data/Lemong-data"

# ============ 颜色输出 ============

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
CYAN='\033[0;36m'
NC='\033[0m' # No Color

# ============ 帮助 ============

show_help() {
  cat << EOF
${CYAN}🍋🎵 Lemong Agent CLI — AI 音乐创作命令行工具${NC}

${YELLOW}用法:${NC} ./lemong-agent/lemong-agent <命令> [参数...]

${YELLOW}命令:${NC}

  ${GREEN}help${NC}                    查看此帮助信息

  ${GREEN}list-styles${NC}             列出所有可用的音乐风格

  ${GREEN}list-templates${NC}          列出所有模板及其问题数量

  ${GREEN}prompt${NC} <风格> <答案JSON> [--singer <歌手名>]
                      根据风格模板 + 用户答案生成歌词和歌曲提示词
                      示例: ./lemong-agent/lemong-agent prompt "中文古风" /tmp/answers.json
                      示例: ./lemong-agent/lemong-agent prompt "流行" /tmp/answers.json --singer "二虎"
                      答案JSON格式: {"q1":"答案1","q2":"答案2",...}

  ${GREEN}lyrics${NC} --theme "主题" [--previous "上一版" --feedback "意见"]
                      生成歌词（支持多轮修改）
                      示例: ./lemong-agent/lemong-agent lyrics --theme "离别的秋天"
                      示例: ./lemong-agent/lemong-agent lyrics --theme "离别的秋天" --previous "..." --feedback "更忧伤一些"

  ${GREEN}generate${NC}                生成音乐文件（MP3）
                      方式一（模板）:
                        ./lemong-agent/lemong-agent generate --style "中文古风" --lyrics "歌词" --title "歌名"
                      方式二（prompt JSON，推荐）:
                        ./lemong-agent/lemong-agent generate --prompt-json path/to/prompt.json --lyrics "歌词" --title "歌名"
                      方式三（指定输出名）:
                        ./lemong-agent/lemong-agent generate ... --output "输出名"

  ${GREEN}from-background${NC} <歌名>  从创作背景生成歌词 + music_prompt（两步流程第一步）
    示例: ./lemong-agent/lemong-agent from-background "幻觉"

  ${GREEN}status${NC}                 查看成品目录状态（文件列表、大小）

${YELLOW}环境变量:${NC}（从 ${AGENT_DIR}/.env 加载）
  DEEPSEEK_API_KEY         DeepSeek V4 API Key（提示词 + 歌词生成）
  DEEPSEEK_BASE_URL        DeepSeek API 地址（默认 https://api.deepseek.com/v1）
  ACE_API_KEY               ACE Step1.5 API Key（音乐生成）

${YELLOW}成品目录:${NC} ${DATA_DIR}/
${YELLOW}模板目录:${NC} ${AGENT_DIR}/templates/
${YELLOW}脚节目录:${NC} ${SCRIPTS_DIR}/

${YELLOW}完整工作流:${NC}
  1. ./lemong-agent/lemong-agent prompt "风格" answers.json  → 生成歌词 + music_prompt
  2. 审阅歌词，不满意则修改
  3. ./lemong-agent/lemong-agent generate --prompt-json output.json  → 生成 MP3
  4. 试听，不满意则调整参数重新生成
  5. 确认成品 → 最终文件保存在 ${DATA_DIR}/{歌名}/

EOF
}

# ============ 列出风格 ============

list_styles() {
  echo -e "${CYAN}可用音乐风格:${NC}"
  echo ""
  printf "  %-12s %s\n" "风格" "特征"
  printf "  %-12s %s\n" "----------" "------------------------------"
  printf "  ${GREEN}%-12s${NC} %s\n" "中文古风"   "传统乐器、诗词韵味、五声调式"
  printf "  ${GREEN}%-12s${NC} %s\n" "流行"       "旋律抓耳、情感表达、标准编制"
  printf "  ${GREEN}%-12s${NC} %s\n" "校园民谣"   "木吉他指弹、青春记忆、温暖真挚"
  printf "  ${GREEN}%-12s${NC} %s\n" "爵士"       "萨克斯/钢琴、Swing、即兴"
  printf "  ${GREEN}%-12s${NC} %s\n" "电子"       "合成器、节奏感强、未来感"
  printf "  ${GREEN}%-12s${NC} %s\n" "男女对唱"   "双人声部、对话感、情感交织"
  echo ""
}

# ============ 列出模板详情 ============

list_templates() {
  local templates_dir="$AGENT_DIR/templates"
  echo -e "${CYAN}模板列表:${NC}"
  echo ""
  printf "  %-14s %s\n" "文件" "描述"
  printf "  %-14s %s\n" "--------------" "------------------------------"
  for f in "$templates_dir"/*.md; do
    local name=$(basename "$f" .md)
    if [ "$name" = "README" ] || [ "$name" = "chord-progressions" ]; then
      continue
    fi
    local count=$(grep -c '^### [0-9]' "$f" 2>/dev/null || echo "?")
    printf "  ${GREEN}%-14s${NC} %s 个问题\n" "$name" "$count"
  done
  echo ""
  echo -e "  ${YELLOW}参考文档:${NC} ${templates_dir}/README.md"
  echo -e "  ${YELLOW}和弦参考:${NC} ${templates_dir}/chord-progressions.md"
  echo ""
}

# ============ 提示词生成 ============

run_prompt() {
  local style=""
  local answers_file=""
  local singer_name=""

  # 解析参数
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --singer)
        singer_name="$2"
        shift 2
        ;;
      *)
        if [ -z "$style" ]; then
          style="$1"
        elif [ -z "$answers_file" ]; then
          answers_file="$1"
        fi
        shift
        ;;
    esac
  done

  if [ -z "$style" ] || [ -z "$answers_file" ]; then
    echo -e "${RED}错误: 用法: ./lemong-agent/lemong-agent prompt <风格名称> <答案JSON文件路径> [--singer <歌手名>]${NC}"
    echo -e "先运行 ${YELLOW}./lemong-agent/lemong-agent list-styles${NC} 查看可用风格"
    exit 1
  fi

  if [ ! -f "$answers_file" ]; then
    echo -e "${RED}错误: 答案文件不存在: $answers_file${NC}"
    exit 1
  fi

  # 加载 Agent 自己的 .env
  if [ -f "$AGENT_DIR/.env" ]; then
    set -a; source "$AGENT_DIR/.env"; set +a
  fi

  if [ -z "${DEEPSEEK_API_KEY:-}" ]; then
    echo -e "${RED}错误: 未设置 DEEPSEEK_API_KEY 环境变量${NC}"
    echo -e "请在 ${YELLOW}$AGENT_DIR/.env${NC} 文件中配置，或 export DEEPSEEK_API_KEY=..."
    exit 1
  fi

  if [ -n "$singer_name" ]; then
    node "$SCRIPTS_DIR/generate-prompt.js" "$style" "$answers_file" --singer "$singer_name"
  else
    node "$SCRIPTS_DIR/generate-prompt.js" "$style" "$answers_file"
  fi
}

# ============ 歌词生成 ============

run_lyrics() {
  # 加载 Agent 自己的 .env
  if [ -f "$AGENT_DIR/.env" ]; then
    set -a; source "$AGENT_DIR/.env"; set +a
  fi

  if [ -z "${DEEPSEEK_API_KEY:-}" ]; then
    echo -e "${RED}错误: 未设置 DEEPSEEK_API_KEY 环境变量${NC}"
    exit 1
  fi

  node "$SCRIPTS_DIR/generate-lyrics.js" "$@"
}

# ============ 音乐生成 ============

run_generate() {
  # 加载 Agent 自己的 .env
  if [ -f "$AGENT_DIR/.env" ]; then
    set -a; source "$AGENT_DIR/.env"; set +a
  fi

  if [ -z "${ACE_API_KEY:-}" ]; then
    echo -e "${RED}错误: 未设置 ACE_API_KEY 环境变量${NC}"
    echo -e "请在 ${YELLOW}$AGENT_DIR/.env${NC} 文件中配置，或 export ACE_API_KEY=..."
    exit 1
  fi

  export LEMONG_DATA_DIR="$DATA_DIR"
  node "$SCRIPTS_DIR/generate-music.js" "$@"
}

# ============ 创作背景驱动：生成歌词 + music_prompt ============

run_from_background() {
  if [ $# -lt 1 ]; then
    echo -e "${RED}错误: 用法: ./lemong-agent/lemong-agent from-background <歌名>${NC}"
    exit 1
  fi

  # 加载 Agent 自己的 .env
  if [ -f "$AGENT_DIR/.env" ]; then
    set -a; source "$AGENT_DIR/.env"; set +a
  fi

  if [ -z "${DEEPSEEK_API_KEY:-}" ]; then
    echo -e "${RED}错误: 未设置 DEEPSEEK_API_KEY 环境变量${NC}"
    echo -e "请在 ${YELLOW}$AGENT_DIR/.env${NC} 文件中配置，或 export DEEPSEEK_API_KEY=..."
    exit 1
  fi

  node "$SCRIPTS_DIR/generate-from-background.js" "$@"
}

# ============ 状态 ============

show_status() {
  echo -e "${CYAN}成品目录: ${DATA_DIR}/${NC}"
  echo ""

  if [ ! -d "$DATA_DIR" ] || [ -z "$(ls -A "$DATA_DIR" 2>/dev/null)" ]; then
    echo -e "  ${YELLOW}(空目录 — 还没有生成过歌曲)${NC}"
    echo ""
    return
  fi

  # 遍历每首歌的子目录
  local total_songs=0
  local total_size=0
  echo -e "${CYAN}歌曲列表:${NC}"
  echo ""

  for song_dir in "$DATA_DIR"/*/; do
    [ -d "$song_dir" ] || continue
    local song_name=$(basename "$song_dir")
    total_songs=$((total_songs + 1))

    printf "  ${GREEN}%-30s${NC} " "$song_name"

    # 检查三件套
    local has_mp3=0; local has_lyrics=0; local has_prompt=0
    [ -f "$song_dir/${song_name}.mp3" ] && has_mp3=1
    [ -f "$song_dir/歌词.md" ] && has_lyrics=1
    [ -f "$song_dir/prompt.json" ] && has_prompt=1

    local complete=0
    if [ $has_mp3 -eq 1 ] && [ $has_lyrics -eq 1 ] && [ $has_prompt -eq 1 ]; then
      complete=1
    fi

    # 显示文件大小
    local mp3_size="—"
    if [ $has_mp3 -eq 1 ]; then
      local fsize=$(stat -c%s "$song_dir/${song_name}.mp3" 2>/dev/null || echo 0)
      total_size=$((total_size + fsize))
      mp3_size="$((fsize / 1024)) KB"
    fi

    if [ $complete -eq 1 ]; then
      printf "%-8s ${GREEN}✅ 完整${NC}\n" "$mp3_size"
    else
      local missing=""
      [ $has_mp3 -eq 0 ] && missing="$missing🎵"
      [ $has_lyrics -eq 0 ] && missing="$missing📝"
      [ $has_prompt -eq 0 ] && missing="$missing📋"
      printf "%-8s ${YELLOW}缺: %s${NC}\n" "$mp3_size" "$missing"
    fi
  done

  echo ""
  echo -e "  共 ${GREEN}${total_songs}${NC} 首歌曲"
  if [ $total_size -gt 0 ]; then
    local total_mb=$(echo "scale=1; $total_size / 1048576" | bc 2>/dev/null || echo "?")
    echo -e "  总大小: ${total_mb} MB"
  fi
  echo ""
}

# ============ 主入口 ============

main() {
  local cmd="${1:-help}"
  shift || true

  case "$cmd" in
    help|--help|-h)
      show_help
      ;;
    list-styles|styles)
      list_styles
      ;;
    list-templates|templates)
      list_templates
      ;;
    prompt)
      if [ $# -lt 2 ]; then
        echo -e "${RED}用法: ./lemong-agent/lemong-agent prompt <风格> <答案JSON文件> [--singer <歌手名>]${NC}"
        exit 1
      fi
      run_prompt "$@"
      ;;
    lyrics)
      run_lyrics "$@"
      ;;
    from-background|fb)
      run_from_background "$@"
      ;;
    generate)
      if [ $# -eq 0 ]; then
        echo -e "${RED}用法: ./lemong-agent/lemong-agent generate --style|--prompt-json ...${NC}"
        echo -e "运行 ${YELLOW}./lemong-agent/lemong-agent help${NC} 查看详细说明"
        exit 1
      fi
      run_generate "$@"
      ;;
    status|st)
      show_status
      ;;
    *)
      echo -e "${RED}未知命令: $cmd${NC}"
      echo -e "运行 ${YELLOW}./lemong-agent/lemong-agent help${NC} 查看可用命令"
      exit 1
      ;;
  esac
}

main "$@"
