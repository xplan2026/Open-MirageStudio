#!/usr/bin/env bash
# ============================================================
# Zhupu Manager Agent CLI — 族谱管理命令行入口
# ============================================================
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
SCRIPTS_DIR="$SCRIPT_DIR/scripts"
WORKSPACE_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"
DATA_DIR="$WORKSPACE_ROOT/data/Zhupu-data"

RED='\033[0;31m'; GREEN='\033[0;32m'; YELLOW='\033[1;33m'; CYAN='\033[0;36m'; BOLD='\033[1m'; NC='\033[0m'

show_help() {
  cat << EOF
${BOLD}${CYAN}🏛️  Zhupu Manager Agent CLI — 族谱管理命令行工具${NC}

${YELLOW}用法:${NC} ./zhupu-manager-agent/zhupu-manager-agent <命令> [参数...]

${YELLOW}命令:${NC}
  ${GREEN}init${NC} <家族名> [--description "描述"] [--emblem <路径>]  初始化新家族
  ${GREEN}add${NC} <家族名> <参数...>                  添加成员（--name, --style-name, --generation, --gender, --avatar, --birth, --achievement "type|title|year|detail" 等）
  ${GREEN}add-interactive${NC} <家族名>                 交互式添加成员（引导式问答，含成就录入）
  ${GREEN}query${NC} <家族名> [--name|--generation|--list|--has-achievement|--achievement-type]  查询成员
  ${GREEN}tree${NC} <家族名>                           查看关系树
  ${GREEN}export${NC} <家族名> [--format <格式>]       导出族谱
  ${GREEN}stats${NC} <家族名>                          统计信息
  ${GREEN}motto${NC} <家族名> "内容"                    设置家训
  ${GREEN}emblem${NC} <家族名> <路径>                  设置族徽/图腾
  ${GREEN}list${NC}                                    列出所有家族
  ${GREEN}help${NC}                                    查看帮助

${YELLOW}数据目录:${NC} ${DATA_DIR}/
${YELLOW}脚节目录:${NC} ${SCRIPTS_DIR}/
EOF
}

# 发布族谱到云端（D1）——失败不阻塞本地操作
publish_family() {
  local fam="$1"
  echo -e "${CYAN}📡 发布族谱到云端 (D1)...${NC}"
  node "$WORKSPACE_ROOT/scripts/publish.js" family "Zhupu-data/$fam" >/dev/null 2>&1 \
    && echo -e "${GREEN}✅ 已发布${NC}" \
    || echo -e "${YELLOW}⚠️ 云端发布失败（产物已在本地保存）${NC}"
}

main() {
  local cmd="${1:-help}"
  shift || true

  case "$cmd" in
    help|--help|-h)
      show_help
      ;;
    init)
      [ -z "${1:-}" ] && { echo -e "${RED}错误: 请指定家族名${NC}"; exit 1; }
      node "$SCRIPTS_DIR/init-family.js" "$@"
      publish_family "${1:-}"
      ;;
    add)
      [ -z "${1:-}" ] && { echo -e "${RED}错误: 请指定家族名${NC}"; exit 1; }
      node "$SCRIPTS_DIR/add-member.js" "$@"
      publish_family "${1:-}"
      ;;
    add-interactive)
      [ -z "${1:-}" ] && { echo -e "${RED}错误: 请指定家族名${NC}"; exit 1; }
      node "$SCRIPTS_DIR/add-member.js" "$1" --interactive
      publish_family "${1:-}"
      ;;
    query)
      [ -z "${1:-}" ] && { echo -e "${RED}错误: 请指定家族名${NC}"; exit 1; }
      node "$SCRIPTS_DIR/query.js" "$@"
      ;;
    tree)
      [ -z "${1:-}" ] && { echo -e "${RED}错误: 请指定家族名${NC}"; exit 1; }
      node "$SCRIPTS_DIR/tree.js" "$@"
      ;;
    export)
      [ -z "${1:-}" ] && { echo -e "${RED}错误: 请指定家族名${NC}"; exit 1; }
      node "$SCRIPTS_DIR/export.js" "$@"
      ;;
    stats)
      [ -z "${1:-}" ] && { echo -e "${RED}错误: 请指定家族名${NC}"; exit 1; }
      node "$SCRIPTS_DIR/stats.js" "$@"
      ;;
    motto)
      [ -z "${1:-}" ] && { echo -e "${RED}错误: 请指定家族名${NC}"; exit 1; }
      node "$SCRIPTS_DIR/export.js" --motto "$@"
      publish_family "${1:-}"
      ;;
    emblem)
      [ -z "${1:-}" ] && { echo -e "${RED}错误: 请指定家族名${NC}"; exit 1; }
      [ -z "${2:-}" ] && { echo -e "${RED}错误: 请指定族徽路径${NC}"; exit 1; }
      node "$SCRIPTS_DIR/export.js" --emblem "$@"
      publish_family "${1:-}"
      ;;
    list)
      node "$SCRIPTS_DIR/query.js" --list-all
      ;;
    *)
      echo -e "${RED}未知命令: $cmd${NC}"
      show_help
      exit 1
      ;;
  esac
}

main "$@"
