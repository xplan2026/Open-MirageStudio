# ==============================================================
# ===          Mirage Studio 环境变量配置 (模板)                ===
# ===         复制此文件为 .env 并填入真实值                     ===
# ==============================================================
#
# 说明:
#   - 此文件仅包含 API 密钥、第三方平台 Token 等业务凭证
#   - 服务器 SSH 配置（私钥、IP、端口等）请配置在 .codebuddy/.env.codebuddy
#   - 两份文件均不得提交到版本控制系统

# -------------- CNB 平台访问令牌 ------------------
CNB_TOKEN=<CNB平台Token>

# -------------- Github 仓库配置 ------------------
GITHUB_REPO=https://github.com/xplan2026/mirage-studio
GITHUB_API_TOKEN=<GitHub API Token>

# -------------- Agent API 凭证 ------------------
DEEPSEEK_API_KEY=<DeepSeek API Key>
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

ACE_API_KEY=<ACE API Key>
ACE_BASE_URL=https://api.acemusic.ai

# -------------- 智谱（LLM 免费模型 / 图片生成 / 视频生成）-----------------
# GLM-4.7-Flash / GLM-4-Flash 免费，用于 Coordinator 意图解析降级 +
# Xujie Writer 小说创作 LLM 网关（scripts/llm-gateway.js 主引擎）
ZHIPU_API_KEY=<智谱 API Key>
ZHIPU_BASE_URL=https://open.bigmodel.cn/api/paas/v4
# ZHIPU_MODEL=glm-4.7-flash   # 可选：覆盖网关主模型

# -------------- 微信 iLink-bot（微信对话通道）-----------------
# 管理员微信 ID（单账号白名单）：
#   留空 = 未绑定，需在 admin-ui「微信对话」扫码登录后自动写入
#   已有值 = 已绑定，禁止再次扫码；非该 ID 的微信消息将被直接忽略
# WECHAT_ADMIN_ID=wxid_xxxxxxxxx

# -------------- 百度文心一格（图片生成）-----------------
BAIDU_AK=<百度 Access Key>
BAIDU_SK=<百度 Secret Key>

# -------------- Cloudflare 凭证 ------------------
CLOUDFLARE_API_TOKEN=<Cloudflare API Token>
CLOUDFLARE_ACCOUNT_ID=<Cloudflare Account ID>

# -------------- Zhupu (族谱) 项目 ------------------
ZP_GITHUB_API_TOKEN=<GitHub Token for Zhupu>
ZP_GITHUB_URL=https://github.com/xplan2026/zhupu.git
